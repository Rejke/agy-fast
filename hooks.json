  "agy-fast-context-guard": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "node -e \"var f=require('fs'),p=require('path'),o=require('os'),u=require('url'),e=process.env,h='',hit=0;try{h=o.homedir()}catch(x){}for(var d of[e.PLUGIN_ROOT,e.AGY_PLUGIN_ROOT,e.GEMINI_HOME?p.join(e.GEMINI_HOME,'config','plugins','agy-fast'):'',h?p.join(h,'.gemini','config','plugins','agy-fast'):'']){if(d){var m=p.resolve(d,'plugin.json');if(f.existsSync(m)){var ok=0;try{ok=JSON.parse(f.readFileSync(m,'utf8')).name==='agy-fast'?1:0}catch(x){}if(ok){var s=p.resolve(d,'dist','pre-invocation.mjs');if(f.existsSync(s)===false)s=p.resolve(d,'dist','session-start.mjs');if(f.existsSync(s)){hit=1;globalThis.__agyFastHook='pre-invocation';import(u.pathToFileURL(s).href).catch(function(){process.stdout.write('{}')});break;}}}}}if(hit===0)process.stdout.write('{}')\"",
        "timeout": 5
      }
    ]
  }
}
