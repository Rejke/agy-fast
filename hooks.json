{
  "agy-fast-snapshot": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node -e \"var f=require('fs'),p=require('path'),o=require('os'),u=require('url'),e=process.env,h='',hit=0;try{h=o.homedir()}catch(x){}for(var d of[e.PLUGIN_ROOT,e.AGY_PLUGIN_ROOT,'.',p.join('.agents','plugins','agy-fast'),h?p.join(h,'.gemini','config','plugins','agy-fast'):'']){if(d){var s=p.resolve(d,'dist','session-start.mjs');if(f.existsSync(s))if(f.existsSync(p.resolve(d,'plugin.json'))){hit=1;import(u.pathToFileURL(s).href).catch(function(){process.stdout.write('{}')});break;}}}if(hit===0)process.stdout.write('{}')\"",
